{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "factor_shocks",
  "description": "calc_impact.py 입력. 시나리오별 팩터 충격 세트. 키는 config/factors.yaml의 이름만 허용(validate_json.py가 추가 검사).",
  "type": "object",
  "required": ["as_of", "scenarios"],
  "properties": {
    "as_of": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {"type": "string"},
    "note": {"type": "string"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "shocks"],
        "properties": {
          "name": {"type": "string"},
          "prob": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "horizon": {"type": "string"},
          "shocks": {"type": "object", "additionalProperties": {"type": "number"}}
        }
      }
    }
  }
}
