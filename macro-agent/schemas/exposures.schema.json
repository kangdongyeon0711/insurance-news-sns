{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exposures",
  "description": "보험사 운용자산 익스포저. knowledge/portfolios/{회사}/{기간}.json",
  "type": "object",
  "required": ["company", "period", "source_files", "accounting_basis", "total_invested_assets_krw_bn", "assets", "liabilities", "notes"],
  "properties": {
    "company": {"type": "string"},
    "period": {"type": "string", "pattern": "^\\d{4}(Q[1-4]|H[12]|FY)?$"},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "accounting_basis": {"type": "string"},
    "is_sample": {"type": "boolean", "description": "true면 가상 데이터 (실제 회사 아님)"},
    "total_invested_assets_krw_bn": {"type": "number", "minimum": 0},
    "total_flag": {"enum": ["공시", "추정", "미확인"]},
    "total_page_ref": {"type": ["string", "null"]},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class", "region", "currency", "mv_krw_bn", "weight", "value_flag", "page_ref"],
        "properties": {
          "class": {"enum": ["국공채", "특수채", "금융채", "회사채", "해외채", "주식", "수익증권", "해외주식", "대출-부동산PF", "대출-부동산담보", "대출-기업", "대출-신용/약관", "부동산", "대체-인프라", "대체-PE", "대체-사모대출", "현금예금", "기타"]},
          "label": {"type": "string", "description": "공시상 원래 계정명"},
          "region": {"enum": ["KR", "US", "EU", "기타", "혼합"]},
          "currency": {"type": "string"},
          "mv_krw_bn": {"type": "number"},
          "weight": {"type": "number", "minimum": 0, "maximum": 1},
          "mod_duration": {"type": ["number", "null"]},
          "spread_duration": {"type": ["number", "null"]},
          "convexity": {"type": ["number", "null"]},
          "rating_dist": {"type": ["object", "null"], "additionalProperties": {"type": "number"}},
          "credit_grade": {"type": ["string", "null"], "description": "IG|HY|AA|BBB 등 (회사채·해외채 스프레드 팩터 선택용)"},
          "fx_hedge_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "beta": {"type": ["number", "null"]},
          "floating_rate": {"type": ["boolean", "null"]},
          "value_flag": {"enum": ["공시", "추정", "미확인"]},
          "field_flags": {"type": "object", "description": "필드별 출처 플래그. 예: {\"mod_duration\": \"추정\"}", "additionalProperties": {"enum": ["공시", "추정", "미확인"]}},
          "page_ref": {"type": ["string", "null"]}
        }
      }
    },
    "liabilities": {
      "type": "object",
      "required": ["duration", "value_flag", "page_ref"],
      "properties": {
        "duration": {"type": ["number", "null"]},
        "pv_krw_bn": {"type": ["number", "null"], "description": "금리민감 부채 평가액(보험부채 BEL 등)"},
        "value_flag": {"enum": ["공시", "추정", "미확인"]},
        "page_ref": {"type": ["string", "null"]}
      }
    },
    "kics_ratio": {"type": ["number", "null"]},
    "investment_yield": {"type": ["number", "null"]},
    "notes": {"type": "string"}
  }
}
