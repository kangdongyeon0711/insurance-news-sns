{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exposures",
  "description": "금융회사 익스포저(보험사·증권사·자산운용사·은행). knowledge/portfolios/{회사}/{기간}.json. 업종별 의미는 config/entity_profiles.yaml",
  "type": "object",
  "required": [
    "company",
    "period",
    "source_files",
    "accounting_basis",
    "total_invested_assets_krw_bn",
    "assets",
    "liabilities",
    "notes"
  ],
  "properties": {
    "company": {
      "type": "string"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}(Q[1-4]|H[12]|FY)?$"
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accounting_basis": {
      "type": "string"
    },
    "is_sample": {
      "type": "boolean",
      "description": "true면 가상 데이터 (실제 회사 아님)"
    },
    "total_invested_assets_krw_bn": {
      "type": "number",
      "minimum": 0
    },
    "total_flag": {
      "enum": [
        "공시",
        "추정",
        "미확인"
      ]
    },
    "total_page_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "class",
          "region",
          "currency",
          "mv_krw_bn",
          "weight",
          "value_flag",
          "page_ref"
        ],
        "properties": {
          "class": {
            "enum": [
              "국공채",
              "특수채",
              "금융채",
              "회사채",
              "해외채",
              "주식",
              "수익증권",
              "해외주식",
              "대출-부동산PF",
              "대출-부동산담보",
              "대출-기업",
              "대출-신용/약관",
              "부동산",
              "대체-인프라",
              "대체-PE",
              "대체-사모대출",
              "현금예금",
              "기타"
            ]
          },
          "label": {
            "type": "string",
            "description": "공시상 원래 계정명"
          },
          "region": {
            "enum": [
              "KR",
              "US",
              "EU",
              "기타",
              "혼합"
            ]
          },
          "currency": {
            "type": "string"
          },
          "mv_krw_bn": {
            "type": "number"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mod_duration": {
            "type": [
              "number",
              "null"
            ]
          },
          "spread_duration": {
            "type": [
              "number",
              "null"
            ]
          },
          "convexity": {
            "type": [
              "number",
              "null"
            ]
          },
          "rating_dist": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": {
              "type": "number"
            }
          },
          "credit_grade": {
            "type": [
              "string",
              "null"
            ],
            "description": "IG|HY|AA|BBB 등 (회사채·해외채 스프레드 팩터 선택용)"
          },
          "fx_hedge_ratio": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "beta": {
            "type": [
              "number",
              "null"
            ]
          },
          "floating_rate": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "value_flag": {
            "enum": [
              "공시",
              "추정",
              "미확인"
            ]
          },
          "field_flags": {
            "type": "object",
            "description": "필드별 출처 플래그. 예: {\"mod_duration\": \"추정\"}",
            "additionalProperties": {
              "enum": [
                "공시",
                "추정",
                "미확인"
              ]
            }
          },
          "page_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "liabilities": {
      "type": "object",
      "required": [
        "duration",
        "value_flag",
        "page_ref"
      ],
      "properties": {
        "duration": {
          "type": [
            "number",
            "null"
          ]
        },
        "pv_krw_bn": {
          "type": [
            "number",
            "null"
          ],
          "description": "금리민감 부채 평가액(보험부채 BEL 등)"
        },
        "value_flag": {
          "enum": [
            "공시",
            "추정",
            "미확인"
          ]
        },
        "page_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "description": "부채 듀레이션·규모의 산출 기준(예: PAP, 장기보험료부채+장기위험마진)"
        },
        "pv_flag": {
          "enum": [
            "공시",
            "추정",
            "미확인"
          ],
          "description": "pv_krw_bn의 출처 플래그(공시 민감도 역산이면 추정)"
        }
      }
    },
    "kics_ratio": {
      "type": [
        "number",
        "null"
      ]
    },
    "investment_yield": {
      "type": [
        "number",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "insurer",
        "securities",
        "asset_manager",
        "bank",
        "other"
      ],
      "description": "업종. 생략 시 insurer로 간주(하위호환)"
    },
    "capital_ratios": {
      "type": "array",
      "description": "업종별 자본비율(K-ICS, NCR, BIS 등)",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "value_flag"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_flag": {
            "enum": [
              "공시",
              "추정",
              "미확인"
            ]
          },
          "page_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "rate_sensitivity_disclosed": {
      "type": "array",
      "description": "회사가 공시한 금리 민감도(예: ±50bp 시 자산·부채·가용자본 변화, 십억원). calc_impact가 엔진 결과와 대조(캘리브레이션)",
      "items": {
        "type": "object",
        "required": [
          "shock_bp",
          "value_flag"
        ],
        "properties": {
          "shock_bp": {
            "type": "number"
          },
          "asset_chg_krw_bn": {
            "type": [
              "number",
              "null"
            ]
          },
          "liab_chg_krw_bn": {
            "type": [
              "number",
              "null"
            ]
          },
          "capital_chg_krw_bn": {
            "type": [
              "number",
              "null"
            ]
          },
          "ratio_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "ratio_chg_pp": {
            "type": [
              "number",
              "null"
            ]
          },
          "basis": {
            "type": "string",
            "description": "산출 기준(예: PAP, 자산=채권·대출, 부채=장기보험료부채)"
          },
          "value_flag": {
            "enum": [
              "공시",
              "추정",
              "미확인"
            ]
          },
          "page_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "contingent": {
      "type": "array",
      "description": "우발채무(증권사 PF 채무보증 등). 손실률 팩터로 손실 추정, 손익에 포함",
      "items": {
        "type": "object",
        "required": [
          "class",
          "exposure_krw_bn",
          "value_flag",
          "page_ref"
        ],
        "properties": {
          "class": {
            "enum": [
              "국공채",
              "특수채",
              "금융채",
              "회사채",
              "해외채",
              "주식",
              "수익증권",
              "해외주식",
              "대출-부동산PF",
              "대출-부동산담보",
              "대출-기업",
              "대출-신용/약관",
              "부동산",
              "대체-인프라",
              "대체-PE",
              "대체-사모대출",
              "현금예금",
              "기타"
            ]
          },
          "label": {
            "type": "string"
          },
          "region": {
            "enum": [
              "KR",
              "US",
              "EU",
              "기타",
              "혼합"
            ]
          },
          "exposure_krw_bn": {
            "type": "number"
          },
          "loss_beta": {
            "type": [
              "number",
              "null"
            ],
            "description": "손실률 팩터 적용 배수(미기재 시 assumptions.pf_loss_beta)"
          },
          "value_flag": {
            "enum": [
              "공시",
              "추정",
              "미확인"
            ]
          },
          "page_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "aum": {
      "type": "array",
      "description": "자산운용사 운용자산(AUM) 유형별. 시나리오별 AUM 평가 변화 × 보수율 = 연간 보수수익 영향",
      "items": {
        "type": "object",
        "required": [
          "class",
          "region",
          "currency",
          "aum_krw_bn",
          "value_flag",
          "page_ref"
        ],
        "properties": {
          "class": {
            "enum": [
              "국공채",
              "특수채",
              "금융채",
              "회사채",
              "해외채",
              "주식",
              "수익증권",
              "해외주식",
              "대출-부동산PF",
              "대출-부동산담보",
              "대출-기업",
              "대출-신용/약관",
              "부동산",
              "대체-인프라",
              "대체-PE",
              "대체-사모대출",
              "현금예금",
              "기타"
            ]
          },
          "label": {
            "type": "string"
          },
          "region": {
            "enum": [
              "KR",
              "US",
              "EU",
              "기타",
              "혼합"
            ]
          },
          "currency": {
            "type": "string"
          },
          "aum_krw_bn": {
            "type": "number"
          },
          "fee_bp": {
            "type": [
              "number",
              "null"
            ],
            "description": "연 운용보수율(bp). 미기재 시 assumptions.aum_fee_bp"
          },
          "mod_duration": {
            "type": [
              "number",
              "null"
            ]
          },
          "credit_grade": {
            "type": [
              "string",
              "null"
            ]
          },
          "fx_hedge_ratio": {
            "type": [
              "number",
              "null"
            ]
          },
          "value_flag": {
            "enum": [
              "공시",
              "추정",
              "미확인"
            ]
          },
          "page_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "key_metrics": {
      "type": "object",
      "description": "업종별 핵심 지표(투자이익률, CSM, ROE, NCR, 수수료수익 등). {이름: {value, unit, value_flag, page_ref}}",
      "additionalProperties": {
        "type": "object",
        "required": [
          "value",
          "value_flag"
        ],
        "properties": {
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "value_flag": {
            "enum": [
              "공시",
              "추정",
              "미확인"
            ]
          },
          "page_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
