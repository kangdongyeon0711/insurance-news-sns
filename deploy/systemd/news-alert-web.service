[Unit]
Description=insurance-news-sns web viewer (gunicorn)
After=network.target

[Service]
Type=simple
User=news-alert
WorkingDirectory=/opt/insurance-news-sns
EnvironmentFile=/opt/insurance-news-sns/.env
ExecStart=/opt/insurance-news-sns/.venv/bin/gunicorn --bind 0.0.0.0:8000 "news_alert.web.app:create_app()"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
