# mock 모드 — true로 설정하면 수집기/요약기가 실제 API·네트워크를 호출하지 않고
# 미리 만들어둔 샘플 데이터를 반환한다 (로컬 개발/데모/오프라인 테스트용).
USE_MOCK=false

# LLM 요약용
ANTHROPIC_API_KEY=

# Slack 발송용
SLACK_WEBHOOK_URL=

# 이메일 발송용
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=
EMAIL_RECIPIENTS=

# 텔레그램 발송용
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
